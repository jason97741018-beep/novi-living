{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "noviliving.co.nz" }],
      "destination": "https://www.noviliving.co.nz/:path*",
      "permanent": true
    }
  ]
}
